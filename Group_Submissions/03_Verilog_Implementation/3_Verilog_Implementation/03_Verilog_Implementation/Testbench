
`timescale 1ns / 1ps

module age_group_detector_tb;

    reg clk;
    reg reset;
    reg start;
    reg ack;
    reg [4:0] age_switches;

    wire child_led;
    wire teen_led;
    wire adult_led;
    wire senior_led;

    integer i;
    integer pass_count;
    integer fail_count;

    // DUT instantiation
    age_group_detector DUT (
        .clk(clk),
        .reset(reset),
        .start(start),
        .ack(ack),
        .age_switches(age_switches),
        .child_led(child_led),
        .teen_led(teen_led),
        .adult_led(adult_led),
        .senior_led(senior_led)
    );

    // Clock generation: 10 ns period
    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end

    // Main test sequence
    initial begin

        reset = 1;
        start = 0;
        ack = 0;
        age_switches = 0;

        pass_count = 0;
        fail_count = 0;

        // Apply reset
        @(negedge clk);
        reset = 0;

        // Test all 32 ages
        for (i = 0; i < 32; i = i + 1) begin

            @(negedge clk);
            age_switches = i;
            start = 1;

            @(negedge clk);
            start = 0;

            // Allow FSM to classify age
            repeat (2) @(posedge clk);
            #1;

            // Check expected LED
            if (
                (i <= 12 && child_led && !teen_led &&
                 !adult_led && !senior_led) ||

                (i >= 13 && i <= 19 && !child_led &&
                 teen_led && !adult_led && !senior_led) ||

                (i >= 20 && i <= 25 && !child_led &&
                 !teen_led && adult_led && !senior_led) ||

                (i >= 26 && i <= 31 && !child_led &&
                 !teen_led && !adult_led && senior_led)
            ) begin
                $display("PASS: Age = %0d", i);
                pass_count = pass_count + 1;
            end
            else begin
                $display("FAIL: Age = %0d", i);
                fail_count = fail_count + 1;
            end

            // ACK: return to IDLE
            @(negedge clk);
            ack = 1;

            @(negedge clk);
            ack = 0;

            @(posedge clk);
        end

        $display("--------------------------------");
        $display("TOTAL TESTS = 32");
        $display("PASSED = %0d", pass_count);
        $display("FAILED = %0d", fail_count);
        $display("--------------------------------");

        if (fail_count == 0)
            $display("ALL TESTS PASSED!");

        else
            $display("SOME TESTS FAILED!");

        $finish;
    end

endmodule
